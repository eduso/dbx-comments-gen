    },
    {
      "name": "ds_filtro_tabla",
      "displayName": "Filtro tabla",
      "queryLines": [
        "SELECT DISTINCT r.nombre_tabla\n",
        "FROM IDENTIFIER(:results_catalog || '.' || :results_schema || '.resultados') r\n",
        "JOIN IDENTIFIER(:results_catalog || '.' || :results_schema || '.ejecuciones') e\n",
        "  ON r.id_ejecucion = e.id_ejecucion\n",
        "WHERE (:fecha IS NULL OR CAST(e.fecha_ejecucion AS DATE) = :fecha)\n",
        "  AND (:esquema IS NULL OR r.nombre_esquema = :esquema)\n",
        "ORDER BY r.nombre_tabla"
      ],
      "parameters": [
