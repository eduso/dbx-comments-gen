{
  "datasets": [
    {
      "name": "ds_resultados",
      "displayName": "Resultados de comentarios",
      "queryLines": [
        "SELECT\n",
        "  r.nombre_esquema AS Esquema,\n",
        "  r.nombre_tabla AS Tabla,\n",
        "  r.nombre_columna AS Columna,\n",
        "  r.comentario AS `Comentario generado`,\n",
        "  r.status AS `Status revision`,\n",
        "  r.user_comments AS `Comentarios revisor`,\n",
        "  r.fecha_resultado AS `Fecha resultado`,\n",
        "  e.id_ejecucion AS `ID ejecucion`,\n",
        "  e.estado AS `Estado ejecucion`,\n",
        "  e.fecha_ejecucion AS `Fecha ejecucion`\n",
        "FROM IDENTIFIER(:results_catalog || '.' || :results_schema || '.resultados') r\n",
        "JOIN IDENTIFIER(:results_catalog || '.' || :results_schema || '.ejecuciones') e\n",
        "  ON r.id_ejecucion = e.id_ejecucion\n",
        "WHERE (:fecha IS NULL OR CAST(e.fecha_ejecucion AS DATE) = :fecha)\n",
        "  AND (:esquema IS NULL OR r.nombre_esquema = :esquema)\n",
        "  AND (:tabla IS NULL OR r.nombre_tabla = :tabla)\n",
        "  AND (:status IS NULL OR r.status = :status)\n",
        "ORDER BY r.fecha_resultado DESC"
      ],
      "parameters": [
        {
          "displayName": "results_catalog",
          "keyword": "results_catalog",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "results_schema",
          "keyword": "results_schema",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {}
        },
        {
          "displayName": "esquema",
          "keyword": "esquema",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "tabla",
          "keyword": "tabla",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "status",
          "keyword": "status",
          "dataType": "STRING",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "ds_ejecuciones",
      "displayName": "Resumen de ejecuciones",
      "queryLines": [
        "SELECT\n",
        "  e.id_ejecucion AS `ID ejecucion`,\n",
        "  e.fecha_ejecucion AS `Fecha ejecucion`,\n",
        "  e.estado AS Estado,\n",
        "  e.resultado AS Resultado,\n",
        "  COUNT(r.id_resultado) AS `Comentarios generados`\n",
        "FROM IDENTIFIER(:results_catalog || '.' || :results_schema || '.ejecuciones') e\n",
        "LEFT JOIN IDENTIFIER(:results_catalog || '.' || :results_schema || '.resultados') r\n",
        "  ON e.id_ejecucion = r.id_ejecucion\n",
        "WHERE (:fecha IS NULL OR CAST(e.fecha_ejecucion AS DATE) = :fecha)\n",
        "GROUP BY e.id_ejecucion, e.fecha_ejecucion, e.estado, e.resultado\n",
        "ORDER BY e.fecha_ejecucion DESC"
      ],
      "parameters": [
        {
          "displayName": "results_catalog",
          "keyword": "results_catalog",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "results_schema",
          "keyword": "results_schema",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "ds_kpi_ejecuciones",
      "displayName": "KPI Ejecuciones",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT e.id_ejecucion) AS `Total ejecuciones`,\n",
        "  COUNT(r.id_resultado) AS `Total comentarios`,\n",
        "  COUNT(DISTINCT r.nombre_esquema) AS `Esquemas procesados`,\n",
        "  COUNT(DISTINCT r.nombre_tabla) AS `Tablas procesadas`,\n",
        "  SUM(CASE WHEN r.status = 'aprobado' THEN 1 ELSE 0 END) AS `Aprobados`,\n",
        "  SUM(CASE WHEN r.status = 'por revisar' THEN 1 ELSE 0 END) AS `Por revisar`,\n",
        "  SUM(CASE WHEN r.status = 'rechazado' THEN 1 ELSE 0 END) AS `Rechazados`\n",
        "FROM IDENTIFIER(:results_catalog || '.' || :results_schema || '.ejecuciones') e\n",
        "LEFT JOIN IDENTIFIER(:results_catalog || '.' || :results_schema || '.resultados') r\n",
        "  ON e.id_ejecucion = r.id_ejecucion\n",
        "WHERE (:fecha IS NULL OR CAST(e.fecha_ejecucion AS DATE) = :fecha)\n",
        "  AND (:esquema IS NULL OR r.nombre_esquema = :esquema)\n",
        "  AND (:tabla IS NULL OR r.nombre_tabla = :tabla)\n",
        "  AND (:status IS NULL OR r.status = :status)"
      ],
      "parameters": [
        {
          "displayName": "results_catalog",
          "keyword": "results_catalog",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "results_schema",
          "keyword": "results_schema",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {}
        },
        {
          "displayName": "esquema",
          "keyword": "esquema",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "tabla",
          "keyword": "tabla",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "status",
          "keyword": "status",
          "dataType": "STRING",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "ds_filtro_fecha",
      "displayName": "Filtro fecha",
      "queryLines": [
        "SELECT DISTINCT\n",
        "  CAST(fecha_ejecucion AS DATE) AS fecha_ejecucion\n",
        "FROM IDENTIFIER(:results_catalog || '.' || :results_schema || '.ejecuciones')\n",
        "ORDER BY fecha_ejecucion DESC"
      ],
      "parameters": [
        {
          "displayName": "results_catalog",
          "keyword": "results_catalog",
          "dataType": "STRING",
          "defaultSelection": {}
        },
        {
          "displayName": "results_schema",
          "keyword": "results_schema",
          "dataType": "STRING",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "ds_filtro_esquema",
      "displayName": "Filtro esquema",
      "queryLines": [
        "SELECT DISTINCT r.nombre_esquema\n",
        "FROM IDENTIFIER(:results_catalog || '.' || :results_schema || '.resultados') r\n",
        "JOIN IDENTIFIER(:results_catalog || '.' || :results_schema || '.ejecuciones') e\n",
        "  ON r.id_ejecucion = e.id_ejecucion\n",
        "WHERE (:fecha IS NULL OR CAST(e.fecha_ejecucion AS DATE) = :fecha)\n",
        "ORDER BY r.nombre_esquema"
      ],
      "parameters": [
        {
          "displayName": "results_catalog",
          "keyword": "results_catalog",
